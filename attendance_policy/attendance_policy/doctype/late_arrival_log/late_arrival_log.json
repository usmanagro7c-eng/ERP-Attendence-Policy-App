{
 "doctype": "DocType",
 "name": "Late Arrival Log",
 "module": "Attendance Policy",
 "issingle": 0,
 "custom": 0,
 "engine": "InnoDB",
 "editable_grid": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "title_field": "employee_name",
 "search_fields": "employee,employee_name,grade,attendance_date",
 "show_title_field_in_link": 1,
 "fields": [
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Employee",
   "options": "Employee",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Employee Name",
   "fetch_from": "employee.employee_name",
   "in_list_view": 1
  },
  {
   "fieldname": "department",
   "fieldtype": "Link",
   "label": "Department",
   "options": "Department",
   "fetch_from": "employee.department"
  },
  {
   "fieldname": "attendance_date",
   "fieldtype": "Date",
   "label": "Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "arrival_time",
   "fieldtype": "Time",
   "label": "Arrival",
   "in_list_view": 1
  },
  {
   "fieldname": "exit_time",
   "fieldtype": "Time",
   "label": "Exit"
  },
  {
   "fieldname": "grade",
   "fieldtype": "Select",
   "label": "Grade",
   "options": "Grade 1\nGrade 2\nGrade 3",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "deduction_days",
   "fieldtype": "Float",
   "label": "Deduction (days)",
   "precision": "4",
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending\nProcessed",
   "default": "Pending",
   "in_standard_filter": 1
  },
  {
   "fieldname": "deduction_entry",
   "fieldtype": "Link",
   "label": "Deduction Entry",
   "options": "Late Deduction Entry",
   "read_only": 1
  }
 ],
 "field_order": [
  "employee",
  "employee_name",
  "department",
  "attendance_date",
  "arrival_time",
  "exit_time",
  "grade",
  "deduction_days",
  "status",
  "deduction_entry"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "HR Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "HR User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "autoname": "format:LATE-{#####}"
}