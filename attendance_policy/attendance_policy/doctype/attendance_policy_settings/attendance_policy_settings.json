{
 "doctype": "DocType",
 "name": "Attendance Policy Settings",
 "module": "Attendance Policy",
 "issingle": 1,
 "custom": 0,
 "engine": "InnoDB",
 "editable_grid": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company"
  },
  {
   "fieldname": "s1",
   "fieldtype": "Section Break",
   "label": "Shift & Timing Thresholds"
  },
  {
   "fieldname": "arrival_cutoff",
   "fieldtype": "Time",
   "label": "Arrival cutoff",
   "default": "09:00:00"
  },
  {
   "fieldname": "grade1_end",
   "fieldtype": "Time",
   "label": "Grade 1 ends at",
   "default": "10:00:00"
  },
  {
   "fieldname": "grade2_end",
   "fieldtype": "Time",
   "label": "Grade 2 ends at",
   "default": "11:00:00"
  },
  {
   "fieldname": "second_half_cutoff",
   "fieldtype": "Time",
   "label": "Full-day leave if arrival at/after",
   "default": "13:30:00"
  },
  {
   "fieldname": "skip_morning_late_if_half_day_leave",
   "fieldtype": "Check",
   "label": "Skip morning late grading if employee has approved half-day leave",
   "default": "1"
  },
  {
   "fieldname": "include_skip_auto_attendance_checkins",
   "fieldtype": "Check",
   "label": "Include Check-ins with Skip Auto Attendance (Biometric Devices)",
   "default": "1",
   "description": "Allow processing check-ins created by biometric sync apps (like zkteco_sync) that have skip_auto_attendance enabled"
  },
  {
   "fieldname": "s2",
   "fieldtype": "Section Break",
   "label": "Late Penalty Rates (Fraction of Day)"
  },
  {
   "fieldname": "grade1_deduction",
   "fieldtype": "Float",
   "label": "Grade 1",
   "default": "0.166667",
   "precision": "6"
  },
  {
   "fieldname": "grade2_deduction",
   "fieldtype": "Float",
   "label": "Grade 2",
   "default": "0.333333",
   "precision": "6"
  },
  {
   "fieldname": "grade3_deduction",
   "fieldtype": "Float",
   "label": "Grade 3",
   "default": "0.5",
   "precision": "6"
  },
  {
   "fieldname": "full_day_deduction",
   "fieldtype": "Float",
   "label": "After second-half cutoff",
   "default": "1"
  },
  {
   "fieldname": "s3",
   "fieldtype": "Section Break",
   "label": "Reports & Automated Alerts"
  },
  {
   "fieldname": "habitual_threshold",
   "fieldtype": "Int",
   "label": "Habitual late-comer: late count in month >=",
   "default": "3"
  },
  {
   "fieldname": "report_recipients",
   "fieldtype": "Small Text",
   "label": "Daily report recipients",
   "description": "Comma or new-line separated emails"
  },
  {
   "fieldname": "enable_hr_notification",
   "fieldtype": "Check",
   "label": "Send in-app notification to HR Managers",
   "default": "1"
  },
  {
   "fieldname": "s4",
   "fieldtype": "Section Break",
   "label": "Leave Balance & Adjacent Holidays"
  },
  {
   "fieldname": "casual_leave_type",
   "fieldtype": "Link",
   "label": "Casual/Sick Leave Type",
   "options": "Leave Type"
  },
  {
   "fieldname": "annual_leave_type",
   "fieldtype": "Link",
   "label": "Annual Leave Type",
   "options": "Leave Type"
  },
  {
   "fieldname": "max_consecutive_casual",
   "fieldtype": "Int",
   "label": "Max consecutive casual days",
   "default": "3"
  },
  {
   "fieldname": "count_adjacent_holidays",
   "fieldtype": "Check",
   "label": "Count adjacent holidays/Sundays as leave if Reason is empty",
   "default": "1"
  },
  {
   "fieldname": "adjacent_holidays_in_3day_cap",
   "fieldtype": "Check",
   "label": "Include counted adjacent holidays in 3-consecutive-day cap",
   "default": "0"
  },
  {
   "fieldname": "max_encashable_days",
   "fieldtype": "Int",
   "label": "Max encashable casual leave days per year",
   "default": "10"
  },
  {
   "fieldname": "s5",
   "fieldtype": "Section Break",
   "label": "Month-End & Payroll Deductions"
  },
  {
   "fieldname": "deduct_from_leave_first",
   "fieldtype": "Check",
   "label": "Deduct from casual leave balance first",
   "default": "1"
  },
  {
   "fieldname": "salary_component",
   "fieldtype": "Link",
   "label": "Salary Component",
   "options": "Salary Component",
   "default": "Late Arrival Deduction"
  },
  {
   "fieldname": "salary_days_divisor",
   "fieldtype": "Int",
   "label": "Days in month for per-day salary",
   "default": "30"
  },
  {
   "fieldname": "warn_salary_slip_pending_late",
   "fieldtype": "Check",
   "label": "Warn on Salary Slip if unprocessed pending late logs exist",
   "default": "1"
  },
  {
   "fieldname": "create_journal_entry",
   "fieldtype": "Check",
   "label": "Also create Journal Entry (usually OFF; payroll already books deductions)"
  },
  {
   "fieldname": "je_debit_account",
   "fieldtype": "Link",
   "label": "JE Debit Account",
   "options": "Account",
   "depends_on": "create_journal_entry"
  },
  {
   "fieldname": "je_credit_account",
   "fieldtype": "Link",
   "label": "JE Credit Account",
   "options": "Account",
   "depends_on": "create_journal_entry"
  },
  {
   "fieldname": "section_exemptions",
   "fieldtype": "Section Break",
   "label": "Exemptions"
  },
  {
   "fieldname": "exempt_employees",
   "fieldtype": "Table",
   "label": "Exempt Employees",
   "options": "Attendance Policy Exempt Employee",
   "description": "Employees listed here will be exempted from late arrival grading, deductions, and absence tracking."
  }
 ],
 "field_order": [
  "company",
  "s1",
  "arrival_cutoff",
  "grade1_end",
  "grade2_end",
  "second_half_cutoff",
  "skip_morning_late_if_half_day_leave",
  "include_skip_auto_attendance_checkins",
  "s2",
  "grade1_deduction",
  "grade2_deduction",
  "grade3_deduction",
  "full_day_deduction",
  "s3",
  "habitual_threshold",
  "report_recipients",
  "enable_hr_notification",
  "s4",
  "casual_leave_type",
  "annual_leave_type",
  "max_consecutive_casual",
  "count_adjacent_holidays",
  "adjacent_holidays_in_3day_cap",
  "max_encashable_days",
  "s5",
  "deduct_from_leave_first",
  "salary_component",
  "salary_days_divisor",
  "warn_salary_slip_pending_late",
  "create_journal_entry",
  "je_debit_account",
  "je_credit_account",
  "section_exemptions",
  "exempt_employees"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "HR Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ]
}
